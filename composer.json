{
    "name": "formbridge/formbridge-bundle",
    "description": "Symfony forms as MCP tools, as forms a person completes inside the conversation (MCP Apps), and as tools for Symfony AI agents.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony",
        "form",
        "mcp",
        "mcp-apps",
        "ai",
        "agent"
    ],
    "require": {
        "php": ">=8.2",
        "mcp/sdk": "^0.9",
        "psr/cache": "^2.0|^3.0",
        "psr/container": "^1.1|^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^1.0|^2.0|^3.0",
        "symfony/config": "^7.3|^8.0",
        "symfony/console": "^7.3|^8.0",
        "symfony/dependency-injection": "^7.3|^8.0",
        "symfony/event-dispatcher": "^7.3|^8.0",
        "symfony/form": "^7.3|^8.0",
        "symfony/framework-bundle": "^7.3|^8.0",
        "symfony/http-foundation": "^7.3|^8.0",
        "symfony/http-kernel": "^7.3|^8.0",
        "symfony/lock": "^7.3|^8.0",
        "symfony/mcp-bundle": "^1.0@beta",
        "symfony/routing": "^7.3|^8.0",
        "symfony/security-csrf": "^7.3|^8.0",
        "symfony/service-contracts": "^2.5|^3.0",
        "symfony/translation-contracts": "^2.5|^3.0",
        "symfony/twig-bundle": "^7.3|^8.0",
        "symfony/validator": "^7.3|^8.0"
    },
    "suggest": {
        "symfony/ai-agent": "To give the form tools to Symfony AI agents (form_bridge.agents)",
        "symfony/ai-platform": "To fill forms in from free text with a model (form_bridge.fill)",
        "symfony/rate-limiter": "To limit how often the \"paste a message\" page calls the model (form_bridge.fill.rate_limiter)"
    },
    "autoload": {
        "psr-4": {
            "FormBridge\\": "src/"
        }
    }
}
