/*
 * A minimal MCP Apps host: an MCP client over HTTP that renders a form tool's app in a sandboxed
 * frame. Used by the development preview and by pages that embed an agent.
 */
window.FormBridgeHost = (() => {
    const APP_MIME = 'text/html;profile=mcp-app';
    const FRAME_POLICY = "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; form-action 'none'; base-uri 'none'";

    const modelText = (result) => (result.content || [])
        .filter((item) => item.type === 'text')
        .map((item) => item.text)
        .join('\n');

    async function connect(endpoint) {
        let nextId = 0;
        let session = null;
        let version = null;

        async function send(method, params, isNotification = false) {
            const headers = { 'Content-Type': 'application/json', 'Accept': 'application/json, text/event-stream' };
            if (session) headers['Mcp-Session-Id'] = session;
            if (version) headers['MCP-Protocol-Version'] = version;
            const message = { jsonrpc: '2.0', method, params };
            if (!isNotification) message.id = ++nextId;

            const response = await fetch(endpoint, { method: 'POST', headers, body: JSON.stringify(message) });
            session = response.headers.get('Mcp-Session-Id') || session;
            if (isNotification) return null;

            const text = await response.text();
            // One JSON document, or a server-sent event stream carrying it.
            const documents = (response.headers.get('Content-Type') || '').includes('text/event-stream')
                ? text.split('\n').filter((line) => line.startsWith('data:')).map((line) => line.slice(5).trim())
                : [text];
            for (const document of documents) {
                let parsed;
                try { parsed = JSON.parse(document); } catch { continue; }
                if (parsed.id !== message.id) continue;
                if (parsed.error) throw Object.assign(new Error(parsed.error.message), { rpcError: parsed.error });
                return parsed.result;
            }
            throw new Error('The server did not answer ' + method + ' (HTTP ' + response.status + ').');
        }

        const init = await send('initialize', {
            protocolVersion: '2025-11-25',
            capabilities: { extensions: { 'io.modelcontextprotocol/ui': { mimeTypes: [APP_MIME] } } },
            clientInfo: { name: 'formbridge-preview', version: '0.1.0' },
        });
        version = init.protocolVersion;
        await send('notifications/initialized', {}, true);

        const tools = new Map();
        for (const tool of (await send('tools/list', {})).tools) tools.set(tool.name, tool);

        const visibleTo = (tool, who) => (tool._meta?.ui?.visibility || ['model', 'app']).includes(who);

        const shells = new Map();
        async function shellFor(resourceUri) {
            if (!shells.has(resourceUri)) {
                const resource = await send('resources/read', { uri: resourceUri });
                const content = resource.contents.find((item) => item.mimeType === APP_MIME);
                if (!content) throw new Error('The resource ' + resourceUri + ' is not an MCP App.');
                shells.set(resourceUri, content.text);
            }
            return shells.get(resourceUri);
        }

        async function showForm(frame, tool, args, result, { onFormCall = () => {}, onResize = () => {} } = {}) {
            // No same-origin access, and a content policy that blocks loading and sending. The
            // frame can still navigate itself away, so this is a second line of defence.
            frame.setAttribute('sandbox', 'allow-scripts allow-forms');
            frame.srcdoc = (await shellFor(tool._meta.ui.resourceUri)).replace('<head>', '<head><meta http-equiv="Content-Security-Policy" content="' + FRAME_POLICY + '">');

            const reply = (message) => frame.contentWindow.postMessage(message, '*');
            window.addEventListener('message', async (event) => {
                if (event.source !== frame.contentWindow) return;
                const message = event.data;
                if (!message || message.jsonrpc !== '2.0') return;

                switch (message.method) {
                    case 'ui/initialize':
                        return reply({ jsonrpc: '2.0', id: message.id, result: {
                            protocolVersion: '2026-01-26',
                            hostInfo: { name: 'formbridge-preview', version: '0.1.0' },
                            hostCapabilities: { serverTools: {}, openLinks: {} },
                            hostContext: { theme: matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light', displayMode: 'inline' },
                        } });
                    case 'ui/notifications/initialized':
                        reply({ jsonrpc: '2.0', method: 'ui/notifications/tool-input', params: { arguments: args } });
                        return reply({ jsonrpc: '2.0', method: 'ui/notifications/tool-result', params: result });
                    case 'ui/notifications/size-changed':
                        frame.style.height = Math.max(60, message.params.height + 2) + 'px';
                        return onResize(message.params.height);
                    case 'ui/open-link':
                        if (/^https?:\/\//i.test(String(message.params?.url))) window.open(message.params.url, '_blank', 'noopener');
                        return reply({ jsonrpc: '2.0', id: message.id, result: {} });
                    case 'tools/call': {
                        const called = tools.get(message.params.name);
                        if (!called || !visibleTo(called, 'app')) {
                            return reply({ jsonrpc: '2.0', id: message.id, error: { code: -32601, message: 'This tool is not available to the form.' } });
                        }
                        try {
                            const callResult = await send('tools/call', message.params);
                            onFormCall(message.params.name, callResult);
                            return reply({ jsonrpc: '2.0', id: message.id, result: callResult });
                        } catch (error) {
                            return reply({ jsonrpc: '2.0', id: message.id, error: error.rpcError || { code: -32603, message: error.message } });
                        }
                    }
                    default:
                        if (message.id !== undefined) reply({ jsonrpc: '2.0', id: message.id, error: { code: -32601, message: 'Not supported by this client.' } });
                }
            });
        }

        return {
            tools,
            visibleTo,
            hasForm: (tool) => Boolean(tool._meta?.ui?.resourceUri),
            call: (name, args) => send('tools/call', { name, arguments: args }),
            showForm,
        };
    }

    return { connect, modelText };
})();
